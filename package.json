{
  "name": "neighborline",
  "private": true,
  "version": "0.1.0",
  "description": "A hotline, not a dashboard: voice note in any language to PayPal/Venmo mutual-aid cash, with two-person approval.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "fake-paypal": "pnpm --filter @neighborline/fake-paypal start",
    "dev:web": "pnpm --filter @neighborline/web dev",
    "golive": "pnpm --silent --filter @neighborline/golive golive",
    "check-links": "pnpm --silent --filter @neighborline/golive check-links"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.23",
      "@paypal/agent-toolkit>mathjs": "^15.2.0",
      "@paypal/agent-toolkit>@langchain/core": "0.3.80",
      "vite": "^7.3.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-3644-q5cj-c5c7",
        "GHSA-j4fx-xxwh-2485"
      ]
    }
  }
}
