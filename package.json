{
  "name": "neighborline",
  "private": true,
  "version": "0.1.0",
  "description": "A hotline, not a dashboard: voice note in any language to PayPal/Venmo mutual-aid cash, with two-person approval.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "fake-paypal": "pnpm --filter @neighborline/fake-paypal start",
    "dev:web": "pnpm --filter @neighborline/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  }
}
