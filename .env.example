# Copy to .env (root). `pnpm dev` reads it; every value is optional — the defaults run fully offline:
# local dev database (tools/dev-db :4030) + fake PayPal (tools/fake-paypal :4010) + the approver (apps/approver :4020)
# + fixture AI + the web app (:3000).

# ── Modes ────────────────────────────────────────────────────────────────────
PAYPAL_MODE=fake                  # fake | sandbox
AI_MODE=fixture                   # fixture | live
ENGINE=                           # empty = real engine; "mock" = in-memory UI mock (fallback only)
DEMO_MODE=                        # empty = on only with PAYPAL_MODE=fake (fails closed); true/false to force. Never with live.
                                  # On: /demo, labelled demo keys (Dana scripted; visitors play Marcus on their own runs only),
                                  # demo runs skip household caps. Off: no demo keys, every approval needs an organizer's passkey.

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
PORT=3000                         # used by `pnpm dev`
NEIGHBORLINE_GROUP_SLUG=eastside
NEIGHBORLINE_BEAT_SCALE=1         # scales scripted demo beats (tests use 0.02)

# ── Database ─────────────────────────────────────────────────────────────────
# The web app and the approver are separate processes that share one database.
# Empty DATABASE_URL + `pnpm dev` = tools/dev-db: embedded Postgres (PGlite) served on 127.0.0.1:4030, in memory,
# /api/demo/reset swaps in a fresh one (DEV_DB_CONTROL_URL is set for you). DEV_DB_DIR persists it instead.
# DATABASE_URL = Postgres (Supabase/Render); demo reset is unavailable there because the audit log is append-only.
# (Running the web app alone without DATABASE_URL uses an in-process PGlite; approvals then need an approver
# that can reach the same database, so use `pnpm dev`.)
DATABASE_URL=
PGLITE_DIR=
DEV_DB_PORT=4030
DEV_DB_DIR=

# ── PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ─────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                # from the webhook you register for <public url>/api/webhooks/paypal
# Least privilege: a separate REST app used ONLY for Payouts, given ONLY to the approver process
# (scripts/dev.mjs and scripts/render-start.sh strip these from the web app). Required when PAYPAL_MODE=sandbox.
PAYPAL_PAYOUTS_CLIENT_ID=
PAYPAL_PAYOUTS_CLIENT_SECRET=
PAYPAL_PAYOUTS_WEBHOOK_ID=        # that app's webhook id: payout events are verified by the approver
APPROVER_ALLOW_SHARED_CREDENTIALS= # "true" = local sandbox experiment with the main app's keys (loud warning; never deploy)
# Donor page (PayPal JS SDK: PayPal, Venmo, Pay Later, subscriptions). Empty = clearly labelled simulated button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Monthly plans. Empty = created on first use with Subscriptions API (ensureDonationTiers: $10/$25/$50).
PAYPAL_PLAN_ID=
PAYPAL_PLAN_ID_10=
PAYPAL_PLAN_ID_25=
PAYPAL_PLAN_ID_50=

# ── Fake PayPal (PAYPAL_MODE=fake) ───────────────────────────────────────────
FAKE_PAYPAL_URL=http://localhost:4010
FAKE_PAYPAL_PORT=4010
FAKE_PAYPAL_WEBHOOK_ID=0FAKEWEBHOOK0NEIGHBORLINE01
WEBHOOK_TARGET_URL=http://localhost:3000/api/webhooks/paypal   # where the fake delivers signed webhooks
FAKE_PAYPAL_PROCESSING_DELAY_MS=1500
FAKE_PAYPAL_REPORTING_LAG_MS=0
FAKE_PAYPAL_REJECT_PHONE=false    # true mimics sandbox rejecting recipient_type PHONE
FAKE_PAYPAL_UNCLAIMED_RECEIVERS=rosa.m.delgado@example.com   # receivers with "no PayPal account yet"

# ── Approver (apps/approver: the only process with Payouts credentials) ─────
APPROVER_PORT=4020
APPROVER_URL=http://127.0.0.1:4020
NEIGHBORLINE_APPROVER_SECRET=     # ≥32 chars, HMAC between web and approver. Empty = pnpm dev / render-start generate one per run
# The approver always requires a verified signature from every approver; there is no unsigned mode.

# ── Background jobs (Render Workflows → /api/internal/*) ─────────────────────
NEIGHBORLINE_INTERNAL_SECRET=     # ≥32 chars, shared with workflows/ (never with the approver)

# ── Sessions, isolation and abuse limits ────────────────────────────────────
NEIGHBORLINE_SESSION_SECRET=      # ≥32 chars: signs organizer sessions, visitor cookies and invite codes. Empty = random per process
RATE_LIMITS=on                    # off disables the in-memory token buckets (e2e only)
TRUST_PROXY_HOPS=1                # proxies in front of the app (Render: 1); picks the client IP from X-Forwarded-For

# ── Privacy ──────────────────────────────────────────────────────────────────
AUDIO_RETENTION=none              # none = raw voice notes are wiped after transcription | 24h = kept 0600 in AUDIO_DIR, then deleted
AUDIO_DIR=

# ── MCP server (packages/paypal: neighborline-payouts-mcp) ───────────────────
NEIGHBORLINE_APPROVAL_SECRET=     # ≥32 chars; enables create_payout_batch with HMAC approval tokens

# ── AI providers (AI_MODE=live) ──────────────────────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai (falls back to whichever key exists)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_STRICT_TOOLS=true       # constrained decoding for the forced tool call
OPENAI_API_KEY=                   # also enables speech-to-text + text-to-speech
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=          # optional: minimal | low | medium | high
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
AI_FALLBACK=                      # "fixture" = live model errors fall back to fixtures (logged)
AI_FIXTURE_DEFAULT_AUDIO=lan_vi   # or "none"
AI_FIXTURE_AUDIO_DIR=             # override packages/agents/fixtures/audio
