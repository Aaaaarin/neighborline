# Copy to .env (root). `pnpm dev` reads it; every value is optional — the defaults run fully offline:
# local dev database (tools/dev-db :4030) + fake PayPal (tools/fake-paypal :4010) + the approver (apps/approver :4020)
# + fixture AI + the web app (:3000).

# ── Modes ────────────────────────────────────────────────────────────────────
PAYPAL_MODE=fake                  # fake | sandbox
AI_MODE=fixture                   # fixture | live
PHONE_DEFAULT_REGION=US           # phone numbers said without a country code are read in this region (E.164)
ENGINE=                           # empty = real engine; "mock" = in-memory UI mock (fallback only)
DEMO_MODE=                        # empty = on only with PAYPAL_MODE=fake (fails closed); true/false to force. Never with live.
                                  # On: /demo, labelled demo keys (Dana scripted; visitors play Marcus on their own runs only),
                                  # demo runs skip household caps. Off: no demo keys, every approval needs an organizer's passkey.

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
PORT=3000                         # used by `pnpm dev`
NEIGHBORLINE_GROUP_SLUG=eastside
NEIGHBORLINE_BEAT_SCALE=1         # scales scripted demo beats (tests use 0.02)

# ── Database ─────────────────────────────────────────────────────────────────
# The web app and the approver are separate processes that share one database.
# Empty DATABASE_URL + `pnpm dev` = tools/dev-db: embedded Postgres (PGlite) served on 127.0.0.1:4030, in memory,
# /api/demo/reset swaps in a fresh one (DEV_DB_CONTROL_URL is set for you). DEV_DB_DIR persists it instead.
# DATABASE_URL = Postgres (Supabase/Render); demo reset is unavailable there because the audit log is append-only.
# (Running the web app alone without DATABASE_URL uses an in-process PGlite; approvals then need an approver
# that can reach the same database, so use `pnpm dev`.)
DATABASE_URL=
PGLITE_DIR=
DEV_DB_PORT=4030
DEV_DB_DIR=

# ── PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ─────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                # from the webhook you register for <public url>/api/webhooks/paypal
SANDBOX_DEMO_RECEIVER_EMAIL=      # sandbox only (+ DEMO_MODE on): /demo payouts for Lan/Jean/Walter go to this sandbox Personal
                                  # account's PayPal wallet (sandbox Venmo doesn't settle); Rosa's to a fresh unregistered
                                  # address so it really goes UNCLAIMED. Rail checks run on the scripted destination first.
# Least privilege: a separate REST app used ONLY for Payouts, given ONLY to the approver process
# (scripts/dev.mjs and scripts/render-start.sh strip these from the web app). Required when PAYPAL_MODE=sandbox.
PAYPAL_PAYOUTS_CLIENT_ID=
PAYPAL_PAYOUTS_CLIENT_SECRET=
PAYPAL_PAYOUTS_WEBHOOK_ID=        # that app's webhook id: payout events are verified by the approver
APPROVER_ALLOW_SHARED_CREDENTIALS= # "true" = local sandbox experiment with the main app's keys (loud warning; never deploy)
# Donor page (PayPal JS SDK: PayPal, Venmo, Pay Later, subscriptions). Empty = clearly labelled simulated button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Monthly plans. Empty = created on first use with Subscriptions API (ensureDonationTiers: $10/$25/$50).
PAYPAL_PLAN_ID=
PAYPAL_PLAN_ID_10=
PAYPAL_PLAN_ID_25=
PAYPAL_PLAN_ID_50=

# ── Fake PayPal (PAYPAL_MODE=fake) ───────────────────────────────────────────
FAKE_PAYPAL_URL=http://localhost:4010
FAKE_PAYPAL_PORT=4010
FAKE_PAYPAL_WEBHOOK_ID=0FAKEWEBHOOK0NEIGHBORLINE01
WEBHOOK_TARGET_URL=http://localhost:3000/api/webhooks/paypal   # where the fake delivers signed webhooks
FAKE_PAYPAL_PROCESSING_DELAY_MS=1500
FAKE_PAYPAL_REPORTING_LAG_MS=0
FAKE_PAYPAL_REJECT_PHONE=false    # true mimics sandbox rejecting recipient_type PHONE
FAKE_PAYPAL_UNCLAIMED_RECEIVERS=rosa.m.delgado@example.com   # receivers with "no PayPal account yet"

# ── Approver (apps/approver: the only process with Payouts credentials) ─────
APPROVER_PORT=4020
APPROVER_URL=http://127.0.0.1:4020
NEIGHBORLINE_APPROVER_SECRET=     # ≥32 chars, HMAC between web and approver. Empty = pnpm dev / render-start generate one per run
# The approver always requires a verified signature from every approver; there is no unsigned mode.

# ── Background jobs (Render Workflows → /api/internal/*) ─────────────────────
NEIGHBORLINE_INTERNAL_SECRET=     # ≥32 chars, shared with workflows/ (never with the approver)

# ── Sessions, isolation and abuse limits ────────────────────────────────────
NEIGHBORLINE_SESSION_SECRET=      # ≥32 chars: signs organizer sessions, visitor cookies and invite codes. Empty = random per process
RATE_LIMITS=on                    # off disables the token buckets (e2e only)
RATE_LIMIT_STORE=auto             # auto = Postgres buckets shared by every instance when the engine has a shared database (DATABASE_URL / on-disk PGlite), else in-process | memory = always in-process
HUMAN_CHECK=auto                  # bot check before model-using intake. auto = none in fixture mode; AI_MODE=live: Turnstile if both keys below are set, else proof of work | off | pow | turnstile
TURNSTILE_SITE_KEY=               # Cloudflare Turnstile widget (public). Both keys set + AI_MODE=live = Turnstile, and the CSP allows challenges.cloudflare.com
TURNSTILE_SECRET=                 # Cloudflare Turnstile secret (server-side siteverify only)
HUMAN_CHECK_POW_BITS=14           # proof-of-work difficulty: 32 puzzles of this many zero bits (~200 ms in a laptop browser at 14; each +1 doubles it)
PUBLIC_QUEUE=                     # on | off. Anonymous readers see the redacted organizer queue. Empty = follows DEMO_MODE (a real group: off, organizers only)
TRUST_PROXY_HOPS=1                # proxies in front of the app (Render: 1); picks the client IP from X-Forwarded-For

# ── Privacy ──────────────────────────────────────────────────────────────────
AUDIO_RETENTION=none              # none = raw voice notes are wiped after transcription | 24h = kept 0600 in AUDIO_DIR, then deleted
AUDIO_DIR=

# ── MCP server (packages/paypal: neighborline-payouts-mcp) ───────────────────
NEIGHBORLINE_APPROVAL_SECRET=     # ≥32 chars; enables create_payout_batch with HMAC approval tokens

# ── AI providers (AI_MODE=live) ──────────────────────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai (falls back to whichever key exists) | openai-compatible (local model, docs/AI.md)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_STRICT_TOOLS=true       # constrained decoding for the forced tool call
OPENAI_API_KEY=                   # also enables speech-to-text + text-to-speech
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=          # optional: minimal | low | medium | high
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# LLM_PROVIDER=openai-compatible: Ollama / llama-server / vLLM / LM Studio. Never falls back to a cloud LLM.
OPENAI_COMPAT_BASE_URL=           # e.g. http://localhost:11434/v1 (Ollama), http://localhost:8080/v1 (llama-server)
OPENAI_COMPAT_MODEL=              # e.g. qwen2.5:7b-instruct
OPENAI_COMPAT_API_KEY=            # only if the server requires one
OPENAI_COMPAT_STRUCTURED=         # json_schema (default) | json_object | prompt
AI_FALLBACK=                      # "fixture" = live model errors fall back to fixtures (logged)
AI_FIXTURE_DEFAULT_AUDIO=lan_vi   # or "none"
AI_FIXTURE_AUDIO_DIR=             # override packages/agents/fixtures/audio

# ── Phone line (Twilio Voice; docs/PHONE.md) ─────────────────────────────────
# Off unless all three are set. Point the number's "A call comes in" webhook at https://<host>/api/voice/incoming (POST).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                # also validates X-Twilio-Signature on every webhook
TWILIO_PHONE_NUMBER=              # E.164, e.g. +15035550199 (caller ID for call-backs)
TWILIO_API_KEY_SID=               # optional: REST auth with an API key instead of the auth token
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM=                  # optional: a VERIFIED SMS sender (A2P 10DLC / verified toll-free). Empty = never text, only call
TWILIO_MESSAGING_SERVICE_SID=     # optional: same, as a Messaging Service
PHONE_PUBLIC_BASE_URL=            # public https origin Twilio calls (default APP_BASE_URL, then RENDER_EXTERNAL_URL)
PHONE_QUIET_HOURS=21-8            # no call-backs 21:00–08:00 group time; "off" to disable
PHONE_TIMEZONE=                   # overrides the group's time zone for quiet hours
PHONE_BLOCK_ANONYMOUS=true        # withheld numbers are asked to call again (we can't call them back)
PHONE_MAX_CALL_SECONDS=600
PHONE_GREETING_LANGS=en,es,vi
TWILIO_SAY_VOICES=                # JSON overrides, e.g. {"vi":"Google.vi-VN-Standard-A"}; null = our TTS

# ── Key day: pnpm golive (docs/GOLIVE.md) ───────────────────────────────────
# Read by scripts/golive only; generated ids land in golive-out/golive.env.
SANDBOX_PERSONAL_EMAIL=           # sandbox PERSONAL test account (sb-…@personal.example.com): PayPal-wallet test payout
SANDBOX_BUYER_EMAIL=              # sandbox account that approves the Orders test checkout (Playwright)
SANDBOX_BUYER_PASSWORD=
SANDBOX_VENMO_HANDLE=             # optional Venmo username for the Venmo test item
RENDER_API_KEY=                   # dashboard.render.com → Account settings → API keys
JUDGE_SANDBOX_BUYER_EMAIL=        # optional: published in DEVPOST for judges' /donate (sandbox only)
JUDGE_SANDBOX_BUYER_PASSWORD=
VIDEO_ID=                         # after the YouTube upload
GOLIVE_WEBHOOK_CAPTURE_URL=       # optional public tunnel → 127.0.0.1:4345 to verify a real webhook before deploy
GOLIVE_HOSTED_PAYPAL_MODE=        # fake | sandbox (default: sandbox when PayPal keys exist)
